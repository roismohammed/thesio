{
  "name": "laravel-react-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun install && cd apps/api && composer install && php -r \"file_exists('.env') || copy('.env.example', '.env');\" && php artisan key:generate --ansi && php artisan migrate --graceful --ansi",
    "dev": "concurrently --kill-others -n api,web -c \"#93c5fd,#c4b5fd\" \"cd apps/api && php artisan serve\" \"cd apps/web && bun run dev\"",
    "dev:api": "cd apps/api && php artisan serve",
    "dev:web": "cd apps/web && bun run dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^8.21.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}